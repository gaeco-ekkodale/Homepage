# =============================================================================
# Homepage Client - local dev server (npm run dev)
# =============================================================================
# Copy this file to `.env` - every value below is a working
# LOCAL default. The passwords are deliberately simple and are intended
# ONLY for local use, never for a deployed environment.
#
# Keycloak: this module expects its OWN realm client
# (VITE_KEYCLOAK_CLIENT_ID=homepage-client). The shipped realm export only
# contains plugin-host-client, so create it once in Keycloak - logging in
# through plugin-host-client would NOT carry your own client roles.
# See Gaeco/_docu/developer/keycloak/own-keycloak-client.md
# =============================================================================

# Service APIs the readiness checklist probes.
# Comment one out to see the "status unknown" degradation for that step.
VITE_GUIDELINE_API_URL=http://localhost:5008
VITE_ONTOLOGY_API_URL=http://localhost:5023
VITE_USECASE_API_URL=http://localhost:5130
VITE_ACCESS_API_URL=http://localhost:5131
VITE_INSTANCE_API_URL=http://localhost:5024

# Routes the steps link to (must match each module's mount route).
VITE_PLATFORMCONFIG_ROUTE=/platform-config
VITE_USECASE_ROUTE=/usecase
VITE_ACCESS_ROUTE=/access
VITE_INSTANCE_ROUTE=/instance

# Demo data affordance - local only.
VITE_ENABLE_DEMO_DATA=true

VITE_KEYCLOAK_AUTHORITY=http://localhost:9345/realms/gaeco
VITE_KEYCLOAK_CLIENT_ID=homepage-client
VITE_MOUNT_PATH=homepage
