# =============================================================================
# Homepage - local docker environment
# =============================================================================
# Copy this file to `.env` - every value below is a working
# LOCAL default. The passwords are deliberately simple and are intended
# ONLY for local use, never for a deployed environment.
#
# IMAGE_BASE_PATH points at the Gaeco Azure Container Registry - log in with
# `az acr login --name crgaeco001` (or change it to your own registry) before the first start.
#
# Keycloak: the browser login for this micro-frontend is handled by the shell.
# Its own client id (homepage-client) is only read by StandaloneApp, which is not
# exported via module federation and therefore never runs in the Docker image -
# so it is set in Client/.env (VITE_KEYCLOAK_CLIENT_ID), not here.
# See Gaeco/_docu/developer/keycloak/own-keycloak-client.md
# =============================================================================

# =============================================================================
# IMAGE TAGS
# =============================================================================
HOMEPAGE_CLIENT_TAG=latest

# =============================================================================
# GLOBAL SETTINGS
# =============================================================================
IMAGE_BASE_PATH=crgaeco001.azurecr.io

# =============================================================================
# EXTERNAL SERVICE HOSTNAMES
# The checklist reads the live state of these services. Omitting one only
# degrades the matching step to "status unknown".
# =============================================================================
GUIDELINE_SERVER_HOSTNAME=localhost:5008
ONTOLOGY_SERVER_HOSTNAME=localhost:5023
USECASE_SERVER_HOSTNAME=localhost:5130
ACCESS_SERVER_HOSTNAME=localhost:5131
INSTANCE_SERVER_HOSTNAME=localhost:5024

# =============================================================================
# HOMEPAGE CLIENT
# =============================================================================
MOUNT_ROUTE=/homepage

# Routes the steps link to - must match each module's own MOUNT_ROUTE.
PLATFORMCONFIG_ROUTE=/platform-config
USECASE_ROUTE=/usecase
ACCESS_ROUTE=/access
INSTANCE_ROUTE=/instance

# Demo data hint - local deployments only.
ENABLE_DEMO_DATA=true

# =============================================================================
# LOCAL DEVELOPMENT ONLY
# Die folgenden Variablen werden in deployed Umgebungen vom Orchestrator
# injiziert und sind ausschliesslich fuer den lokalen Docker-Compose-Betrieb
# benoetigt.
# =============================================================================
ENVIRONMENT_NETWORK=gaeco-local

# --- Override (Port-Bindings)
HOMEPAGE_CLIENT_OUTERPORT=3136
